{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run 推理",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": [
        "run",
        "models/qwen2.5-0.5b.gguf",
        "你好，介绍一下你自己"
